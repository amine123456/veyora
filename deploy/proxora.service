[Unit]
Description=Veyora proxy gateway and website
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=proxora
Group=proxora
WorkingDirectory=/opt/proxora
ExecStart=/usr/bin/node --env-file=/opt/proxora/.env src/server.js
Restart=always
RestartSec=3
# The gateway keeps one connection per tunnel; raise the default file limit.
LimitNOFILE=65536

# Browsers must never exhaust the server: past MemoryMax the kernel kills the largest
# process inside this service (a browser), never something else on the machine, and the
# service itself keeps running.
MemoryHigh=2200M
MemoryMax=2600M
MemorySwapMax=512M
OOMPolicy=continue

# Hardening: the service only needs to write its data directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/proxora/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
