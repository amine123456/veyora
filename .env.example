# Client-facing proxy listener. A non-loopback bind requires a TLS certificate.
PROXY_HOST=127.0.0.1
PROXY_PORT=8080
PROXY_TLS_CERT_FILE=
PROXY_TLS_KEY_FILE=
# Address shown to customers in the dashboard, e.g. https://gate.veyora.io:8080.
# Defaults to PROXY_HOST and PROXY_PORT (https when a TLS certificate is set).
PUBLIC_PROXY_URL=

# Upstream proxy credentials. Keep these values out of source control.
UPSTREAM_PROXY_HOST=upstream.example.com
UPSTREAM_PROXY_PORT=443
UPSTREAM_PROXY_USERNAME=replace_me
UPSTREAM_PROXY_PASSWORD=replace_me

# TLS is used to protect upstream credentials by default. Set this to true only
# when the provider has no TLS proxy endpoint and you accept the exposure risk.
ALLOW_INSECURE_UPSTREAM=false

# How long a sticky session (USER-session-ID) keeps the same exit IP, in seconds.
UPSTREAM_SESSION_TTL_SECONDS=600

# "total" charges upload + download. "download" charges responses only.
# Match this to how the upstream provider reports usage.
BILLING_MODE=total

# Restrict destinations. Leave the hostname allowlist empty to allow public
# Internet hosts; private and special-use IP addresses are always denied.
DESTINATION_ALLOWLIST=
DESTINATION_PORTS=80,443

# Resource and abuse controls.
PROXY_REQUEST_TIMEOUT_MS=30000
PROXY_IDLE_TIMEOUT_MS=60000
PROXY_MAX_TUNNEL_LIFETIME_MS=3600000
CONNECT_HANDSHAKE_MAX_BYTES=65536
MAX_CONNECTIONS_PER_CLIENT=10
MAX_CONNECTIONS_GLOBAL=200
AUTH_ATTEMPTS_PER_MINUTE=60
MAX_CONCURRENT_AUTH=16
DNS_TIMEOUT_MS=3000
QUOTA_RESERVATION_BYTES=1048576

# Optional Stripe payment API. It must remain on loopback and be published only
# through an HTTPS reverse proxy when external webhooks or clients need it.
PAYMENTS_HOST=127.0.0.1
PAYMENTS_PORT=3000
PAYMENT_REQUEST_TIMEOUT_MS=15000
PAYMENT_MAX_BODY_BYTES=1048576
PAYMENT_AUTH_ATTEMPTS_PER_MINUTE=120
PAYMENT_MAX_CONCURRENT_AUTH=8
STRIPE_TIMEOUT_MS=10000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_SUCCESS_URL=https://proxy.example.com/success
CHECKOUT_CANCEL_URL=https://proxy.example.com/cancel

# USDT checkout through NOWPayments (dashboard "Buy traffic"). Leave empty to keep
# manual top-ups only. Set the IPN secret from the NOWPayments dashboard; payment
# notices arrive at <CHECKOUT_SUCCESS_URL origin>/nowpayments/ipn.
# NOWPAYMENTS_SANDBOX=true uses their test environment (fake payments).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false
# USDT on BNB Smart Chain: about $0.09 minimum. TRC-20 (usdttrc20) needs about $11+ per payment.
NOWPAYMENTS_PAY_CURRENCY=usdtbsc

# Comma-separated definitions: id:bytes:price_in_cents:currency
PACKAGES=gb1:1073741824:200:usd,gb5:5368709120:1000:usd,gb10:10737418240:2000:usd

# Single-process persistent state. Passwords are scrypt-hashed.
DATA_FILE=./data/store.json
PROCESSED_PAYMENT_HISTORY_LIMIT=10000

# Lets `npm run admin` top up accounts while the server runs. Loopback only; at least 32
# characters. Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=
ADMIN_PORT=3101

# Mobile proxies (customers add -mobile to their proxy username). Leave the username
# empty to turn mobile off. Host and port default to the residential upstream's.
UPSTREAM_MOBILE_USERNAME=
UPSTREAM_MOBILE_PASSWORD=
UPSTREAM_MOBILE_HOST=
UPSTREAM_MOBILE_PORT=

# USD wallet. Prices and upstream costs in USD. Prepaid GB are spent first; then
# residential traffic costs PRICE_RESIDENTIAL_PER_GB and mobile PRICE_MOBILE_PER_GB.
PRICE_RESIDENTIAL_PER_GB=1.5
PRICE_MOBILE_PER_GB=2.5
PRICE_UNLOCKER_PER_1K=0.8
COST_RESIDENTIAL_PER_GB=0.15
COST_MOBILE_PER_GB=0.29
# Crypto top-ups: id:cents[:bonusPercent].
TOPUPS=usd10:1000,usd25:2500,usd50:5000,usd100:10000:5,usd500:50000:10

# Web Unlocker (POST /v1/unlock with an API key from the dashboard).
UNLOCKER_ENABLED=true
UNLOCKER_MAX_ATTEMPTS=4
UNLOCKER_ATTEMPT_TIMEOUT_MS=30000
UNLOCKER_TOTAL_TIMEOUT_MS=90000
UNLOCKER_MAX_RESPONSE_BYTES=5242880
UNLOCKER_REQUESTS_PER_MINUTE=300
UNLOCKER_MAX_CONCURRENT_PER_ACCOUNT=10
UNLOCKER_MAX_CONCURRENT=30
# Memory the unlocker may use for page bodies; each request books 2x the response cap
# (5 MB pages -> 10 MB each, so 256 MB admits ~25 at once). About 1/4 of free RAM.
UNLOCKER_MEMORY_BUDGET_BYTES=268435456
# Sites charged a multiple of the base price, e.g. amazon.com:2,linkedin.com:5
UNLOCKER_PREMIUM_DOMAINS=
# Added to the built-in list (ticket resale, sneaker launches, the upstream provider).
UNLOCKER_BLOCKED_DOMAINS=
# Per-request cost ledger; defaults to unlocker-ledger.jsonl next to DATA_FILE.
UNLOCKER_LEDGER_FILE=
# The ledger rotates daily (UTC) or at this size; this many archives are kept. Per-site
# totals are kept in unlocker-ledger.stats.json and survive rotation and restarts.
UNLOCKER_LEDGER_MAX_BYTES=52428800
UNLOCKER_LEDGER_KEEP=30
